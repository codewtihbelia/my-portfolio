# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides; defaults loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Cloudinary Configuration for Image Uploads
# Create a free account at cloudinary.com, find your Cloud Name, and create an Unsigned Upload Preset in Settings > Upload
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Administrator Authentication (Explicit credentials required for /administrator)
# Set your desired administrator login credentials:
VITE_ADMIN_USERNAME="admin"
VITE_ADMIN_PASSWORD="Admin@123456"

# Backend Service URL (Required when hosting frontend Static Site separately from backend Web Service on Render)
# Set this in your Render Static Site environment variables to your Render Web Service URL (e.g. https://portfolio-backend.onrender.com)
VITE_API_URL=""

# Google Sheets & Email Notification Webhook (Optional environment override; can also be configured in Admin Settings)
# Deploy your Google Sheet's Apps Script as a Web App and paste the URL here:
GOOGLE_SHEET_WEBHOOK_URL=""
VITE_GOOGLE_SHEET_WEBHOOK_URL=""

# Notification Email for Contact Inquiries & Calendar Invitations
NOTIFICATION_EMAIL=""
VITE_NOTIFICATION_EMAIL=""


