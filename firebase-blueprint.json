{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Developer personal and professional profile details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "professionalTitle": { "type": "string" },
        "shortIntroduction": { "type": "string" },
        "biography": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "profileImage": { "type": "string" },
        "coverImage": { "type": "string" },
        "availability": { "type": "string" },
        "availabilityMessage": { "type": "string" },
        "yearsOfExperience": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "websiteUrl": { "type": "string" }
      },
      "required": ["name", "professionalTitle", "biography"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio project case study",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "shortDescription": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "featured": { "type": "boolean" },
        "thumbnail": { "type": "string" },
        "heroImage": { "type": "string" },
        "gallery": { "type": "array" },
        "technologies": { "type": "array" },
        "features": { "type": "array" },
        "problem": { "type": "string" },
        "solution": { "type": "string" },
        "developmentProcess": { "type": "string" },
        "architecture": { "type": "string" },
        "challenges": { "type": "string" },
        "results": { "type": "string" },
        "role": { "type": "string" },
        "duration": { "type": "string" },
        "client": { "type": "string" },
        "liveUrl": { "type": "string" },
        "repositoryUrl": { "type": "string" },
        "documentationUrl": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "order": { "type": "number" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "slug", "shortDescription", "category", "status", "published"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical skill and proficiency level",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "years": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "category", "level"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Work and professional experience history",
      "type": "object",
      "properties": {
        "position": { "type": "string" },
        "organization": { "type": "string" },
        "location": { "type": "string" },
        "employmentType": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "current": { "type": "boolean" },
        "description": { "type": "string" },
        "responsibilities": { "type": "array" },
        "achievements": { "type": "array" },
        "technologies": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["position", "organization", "employmentType", "startDate"]
    },
    "Education": {
      "title": "Education",
      "description": "Academic background record",
      "type": "object",
      "properties": {
        "institution": { "type": "string" },
        "degree": { "type": "string" },
        "field": { "type": "string" },
        "location": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "description": { "type": "string" },
        "achievements": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["institution", "degree", "field"]
    },
    "Certification": {
      "title": "Certification",
      "description": "Professional certificate and credential",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "credentialId": { "type": "string" },
        "issueDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "credentialUrl": { "type": "string" },
        "certificateImage": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "issuer"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offering and capabilities",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "features": { "type": "array" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["title", "slug", "description"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Article and blog post item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "coverImage": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "author": { "type": "string" },
        "status": { "type": "string" },
        "featured": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "readingTime": { "type": "string" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" }
      },
      "required": ["title", "slug", "excerpt", "content", "status"]
    },
    "BlogCategory": {
      "title": "BlogCategory",
      "description": "Category for classifying blog posts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "SocialLink": {
      "title": "SocialLink",
      "description": "Social network connection link",
      "type": "object",
      "properties": {
        "platform": { "type": "string" },
        "url": { "type": "string" },
        "username": { "type": "string" },
        "icon": { "type": "string" },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["platform", "url", "enabled"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client or colleague feedback and recommendation",
