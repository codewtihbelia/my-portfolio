    "Analytics": {
      "title": "Analytics",
      "description": "Aggregated visitor and interaction metrics",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "deviceType": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["type", "timestamp"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "resourceId": { "type": "string" },
        "timestamp": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["action", "resource", "timestamp"]
    }
