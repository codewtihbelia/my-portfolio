  "firestore": {
    "/profiles/{profileId}": {
      "schema": "Profile",
      "description": "Personal profile documents"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Portfolio projects collection"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Developer skills collection"
    },
    "/experiences/{experienceId}": {
      "schema": "Experience",
      "description": "Work experiences timeline"
    },
    "/education/{educationId}": {
      "schema": "Education",
      "description": "Education background history"
    },
    "/certifications/{certificationId}": {
      "schema": "Certification",
      "description": "Professional certifications and credentials"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Services offered by the developer"
    },
    "/blogPosts/{blogPostId}": {
      "schema": "BlogPost",
      "description": "Blog posts and case study articles"
    },
    "/blogCategories/{categoryId}": {
      "schema": "BlogCategory",
      "description": "Categories for blog posts"
    },
    "/socialLinks/{socialLinkId}": {
      "schema": "SocialLink",
      "description": "External social links"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Recommendations and testimonials"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Inquiries from visitors via contact form"
    },
    "/resume/{resumeId}": {
      "schema": "Resume",
      "description": "Resume files and metadata"
    },
    "/media/{mediaId}": {
      "schema": "Media",
      "description": "Uploaded media assets metadata"
    },
    "/siteSettings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "Global website configuration settings"
    },
    "/analytics/{analyticsId}": {
      "schema": "Analytics",
      "description": "Visitor events and counts"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Audit logging for admin operations"
    }
  }
}
