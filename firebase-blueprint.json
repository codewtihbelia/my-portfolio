      "required": ["name", "email", "message", "status"]
    },
    "Resume": {
      "title": "Resume",
      "description": "Resume document metadata and download tracking",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "fileUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "version": { "type": "string" },
        "active": { "type": "boolean" },
        "summary": { "type": "string" },
        "downloadCount": { "type": "number" }
      },
      "required": ["title", "fileUrl", "active"]
    },
    "Media": {
      "title": "Media",
      "description": "Media library asset metadata",
      "type": "object",
      "properties": {
        "filename": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "type": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "altText": { "type": "string" },
        "category": { "type": "string" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["filename", "url", "type"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global portfolio website settings and configuration",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "favicon": { "type": "string" },
        "logo": { "type": "string" },
        "defaultOgImage": { "type": "string" },
        "primaryEmail": { "type": "string" },
        "contactEmail": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "timezone": { "type": "string" },
        "copyrightText": { "type": "string" },
        "googleAnalyticsId": { "type": "string" },
        "defaultMeetUrl": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "showBlog": { "type": "boolean" },
        "showServices": { "type": "boolean" },
        "showTestimonials": { "type": "boolean" },
        "showAnalytics": { "type": "boolean" }
