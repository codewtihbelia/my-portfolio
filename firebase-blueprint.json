      "properties": {
        "name": { "type": "string" },
        "position": { "type": "string" },
        "organization": { "type": "string" },
        "message": { "type": "string" },
        "photo": { "type": "string" },
        "rating": { "type": "number" },
        "featured": { "type": "boolean" },
        "approved": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "message", "rating"]
    },
    "Message": {
      "title": "Message",
      "description": "Contact form inquiry message",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "projectType": { "type": "string" },
        "budget": { "type": "string" },
        "message": { "type": "string" },
        "attachment": { "type": "string" },
        "status": { "type": "string" },
        "scheduledSlot": { "type": "string" },
        "meetLink": { "type": "string" },
        "agenda": { "type": "string" },
        "calendarEventTitle": { "type": "string" },
        "calendarEventId": { "type": "string" },
        "replySentAt": { "type": "string" },
        "replyNotes": { "type": "string" },
        "meetingOutcome": { "type": "string" },
        "meetingNotes": { "type": "string" },
        "completedAt": { "type": "string" },
        "followUpDate": { "type": "string" },
        "convertedProjectId": { "type": "string" }
